{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/contracts/tool-proposal.schema.v1.json",
  "title": "J.A.R.V.I.S. Model Tool Proposal Contract (v1)",
  "description": "Strict schema for untrusted AI model tool proposals. Server exclusively injects actor, session, risk, grant, idempotency_key, and timeout.",
  "type": "object",
  "additionalProperties": false,
  "required": ["steps"],
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool_id", "version", "args"],
        "properties": {
          "tool_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$",
            "maxLength": 64
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "args": {
            "type": "object",
            "maxProperties": 24
          }
        }
      }
    }
  }
}
