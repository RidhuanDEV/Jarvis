{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/contracts/license-artifact.schema.v1.json",
  "title": "J.A.R.V.I.S. 11-Category Artifact & License Inventory Contract (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "category",
    "name",
    "version_or_rev",
    "license_spdx",
    "obligations",
    "source_url",
    "notice_text",
    "verified_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 2, "maxLength": 128 },
    "category": {
      "type": "string",
      "enum": [
        "app_package",
        "native_library",
        "ai_runtime",
        "model_weights",
        "training_dataset",
        "voice_asset",
        "wake_model",
        "font",
        "icon_set",
        "audio_sfx",
        "ui_asset"
      ]
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "version_or_rev": { "type": "string", "minLength": 1, "maxLength": 128 },
    "license_spdx": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "not": { "enum": ["Unknown", "UNKNOWN", "unknown", "UNLICENSED_UNKNOWN", ""] }
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "attribution_notice",
          "include_license_text",
          "preserve_copyright",
          "state_changes",
          "source_offer_or_distribution",
          "network_source_offer",
          "file_level_copyleft",
          "model_card_notice",
          "upstream_dataset_review"
        ]
      }
    },
    "source_url": { "type": "string", "format": "uri" },
    "notice_text": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "verified_at": { "type": "string", "format": "date-time" }
  }
}
