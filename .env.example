# J.A.R.V.I.S. Local Core Runtime Configuration (Example — safe placeholders only)
# Copy to a gitignored .env.local if overriding defaults during local development.
# Never commit real tokens, passphrases, or personal absolute paths.

JARVIS_ENV=development
JARVIS_LOG_LEVEL=INFO
JARVIS_BIND_HOST=127.0.0.1
JARVIS_BIND_PORT=0
JARVIS_RELEASE_SHA=dev-local
# Optional custom base directory for portable/test runs (defaults to OS platformdirs standard location)
# JARVIS_BASE_DATA_DIR=
# Auth token is injected via inherited pipe by the native broker; this placeholder is for isolated test harnesses only:
# JARVIS_AUTH_TOKEN=replace-with-random-64-hex-chars-at-runtime
